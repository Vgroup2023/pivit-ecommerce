# PIVIT Fishing E-Commerce Platform - Environment Configuration
# Copy this file to .env and fill in the required values
# NEVER commit .env to version control (it contains sensitive credentials)

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
# Choose ONE option below:

# OPTION A: Individual Connection Parameters (RECOMMENDED for Render/Vercel)
# No URL encoding needed - special characters handled automatically
DATABASE_HOST=pivit-ecommerce.cgb8aegcyaun.us-east-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=pivit_ecommerce
DATABASE_USER=postgres
DATABASE_PASSWORD=AwsRDS2024!Fishing#Secure9

# OPTION B: Complete Connection URL (Alternative)
# Use if you prefer a single DATABASE_URL
# IMPORTANT: Special characters must be URL-encoded (!, #, :, @ etc)
# DATABASE_URL=postgresql://postgres:AwsRDS2024%21Fishing%23Secure9@pivit-ecommerce.cgb8aegcyaun.us-east-1.rds.amazonaws.com:5432/pivit_ecommerce?sslmode=require

# =============================================================================
# AUTHENTICATION & SECURITY (REQUIRED)
# =============================================================================
# JWT Secret - used to sign authentication tokens
# Minimum 32 characters (at startup validation enforces this)
# Generate: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long

# Session Secret - used by express-session middleware
# Minimum 32 characters (at startup validation enforces this)
# Generate: openssl rand -hex 32
SESSION_SECRET=your-session-secret-key-minimum-32-characters-long

# =============================================================================
# STRIPE PAYMENT INTEGRATION (REQUIRED)
# =============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Webhook secret for Stripe webhook events
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# FRONTEND CONFIGURATION (REQUIRED)
# =============================================================================
# URL where frontend is hosted - used for CORS configuration
# Must match the deployed frontend URL in production
FRONTEND_URL=http://localhost:3000

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port the Express API listens on
PORT=3001

# Node environment (development | production | test)
# Controls security settings, logging verbosity, etc
NODE_ENV=development

# =============================================================================
# REDIS CONFIGURATION (OPTIONAL - but REQUIRED for production)
# =============================================================================
# Redis URL for session storage and caching
# Format: redis://[:password@]host:port
# If not set: app uses in-memory sessions (single instance only, not production-ready)
# For production with multiple instances: REQUIRED
#
# Local development: redis://localhost:6379
# Render add-on: redis://default:password@redis-host:port
# AWS ElastiCache: redis://cluster-host.ng.0001.ue1.cache.amazonaws.com:6379
#
# REDIS_URL=redis://localhost:6379

# =============================================================================
# ERP INTEGRATION (OPTIONAL)
# =============================================================================
# Configure only if using external ERP system
# Both ERP_API_URL and ERP_API_KEY must be set to enable
# ERP_API_URL=https://api.globlex.ai
# ERP_API_KEY=your_erp_api_key_here

# =============================================================================
# DEPLOYMENT INSTRUCTIONS
# =============================================================================
# RENDER BACKEND DEPLOYMENT:
# 1. Use OPTION A (individual DATABASE parameters)
# 2. Set in Render Environment Variables:
#    - DATABASE_HOST, DATABASE_PORT, DATABASE_NAME, DATABASE_USER, DATABASE_PASSWORD
#    - JWT_SECRET, SESSION_SECRET
#    - STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET
#    - FRONTEND_URL (your deployed Vercel URL)
#    - NODE_ENV=production
#    - REDIS_URL (if using Redis for production)
# 3. Application validates all required vars at startup - helpful error messages
# 4. Deploy via git push to render branch
#
# VERCEL FRONTEND DEPLOYMENT:
# Set environment variable in Vercel dashboard:
# - VITE_API_URL=https://your-render-api-url.render.com
#
# LOCAL DEVELOPMENT:
# 1. Copy this file to .env
# 2. Fill in your local values (can use localhost for DATABASE_HOST)
# 3. Run: npm run dev
# 4. Add .env to .gitignore
#
# SECURITY BEST PRACTICES:
# - Use strong random values for JWT_SECRET and SESSION_SECRET
# - Rotate secrets periodically in production
# - Never commit .env or secrets to git
# - Use platform's secret management (Render, Vercel, AWS Secrets Manager)
# - Enable HTTPS in production (automatic with Render/Vercel)
# - Use environment-specific secrets for each deployment
